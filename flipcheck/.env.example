# Copy this file to web/.env.local and fill in values.
# Never commit the filled-in version.

# Required — Anthropic API key (server-side only, never ship to mobile)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional — default is claude-opus-4-7
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional — free scans before paywall (read by mobile app)
# FREE_SCANS_PER_MONTH=3
